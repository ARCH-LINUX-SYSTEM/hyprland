{
    "appearance": {
        "transparency": {
            "enabled": true
        },
        "wallpaperTheming": {
            "managed": true,
            "terminalGenerationProps": {
                "forceDarkMode": false
            }
        }
    },
    "background": {
        "centeredWallpaper": false,
        "visualiser": {
            "autoHide": false,
            "blur": true,
            "enabled": true
        },
        "wallpaperEnabled": true
    },
    "configVersion": 3,
    "dock": {
        "enabled": false,
        "hoverToReveal": true,
        "monochromeIcons": false,
        "pinnedApps": [
            "brave-browser",
            "kitty",
            "cursor",
            "thunar",
            "@caelestia-nexus"
        ],
        "pinnedOnStartup": false,
        "showAppsButton": false,
        "showBackground": true,
        "showMedia": true,
        "showPinButton": false
    },
    "general": {
        "battery": {
            "criticalLevel": 20,
            "hibernateDelay": 60
        },
        "idle": {
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 3600
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 7500
                },
                {
                    "idleAction": [
                        "suspendThenHibernate"
                    ],
                    "timeout": 9000
                }
            ]
        },
        "showOverFullscreen": true
    },
    "hyprland": {
        "autostartApps": {
            "enabled": true
        },
        "enabled": true
    },
    "lock": {
        "enabled": true,
        "recolourLogo": true
    },
    "nexus": {
        "useSystemFileDialog": true,
        "wallpaperChangeInterval": 0
    },
    "osd": {
        "enableMicrophone": false
    },
    "overview": {
        "style": "niri"
    },
    "paths": {
        "wallpaperDir": "~/caelestia/assets/pictures"
    },
    "regionSelector": {
        "annotation": {
            "useSatty": true
        }
    },
    "search": {
        "imageSearch": {
            "useCircleSelection": true
        }
    },
    "services": {
        "pauseWallpaperOnBattery": false,
        "pauseWallpaperOnWindowOverlap": false
    },
    "time": {
        "secondPrecision": true
    }
}
