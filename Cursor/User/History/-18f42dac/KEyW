# ============================================================================
# Gateway — local development env (gitignored). Generated 2026-11-10.
# ============================================================================
NODE_ENV=development
PORT=8888
# APP_ENV=            # label for GET /test-scenarios/meta (fallback: NODE_ENV)
# SERVICE_HOST=       # request_logs.host (fallback: gateway:${PORT})

# --- HTTP edge ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=1                 # must match proxy hop count behind Railway
COOKIE_SECURE=false                # refresh cookie is always secure when NODE_ENV=production
NOTIFICATION_REDIRECT_HOSTS=localhost
# true = let requests through when the redis session check (third-service) is down
SESSION_CHECK_FAIL_OPEN=false

# --- JWT (MUST be identical to the user service's .env) ----------------------
JWT_ACCESS_SECRET=214c015773021ea51688771d4b60459f061c60758559ce20b5e2753b82f089114279cd7cb072736ed617048595a0df1d
JWT_REFRESH_SECRET=fa32279a24a14a099fc42c71ac0cab305d44413d9b9bf571c5a2654a9c1e532b92150120cfa20f94fba54f7307c47c14
JWT_ACCESS_EXPIRES_SECONDS=10800   # 3h
JWT_REFRESH_EXPIRES_SECONDS=604800 # 7d

# --- RabbitMQ (matches docker-compose.infra.yml RABBITMQ_USER/PASSWORD) -----
RABBITMQ_URL=amqp://admin:admin@localhost:5672
USER_QUEUE=user_queue
TUTOR_QUEUE=tutor_queue
THIRD_QUEUE=third_queue

# --- OAuth (gateway fails at BOOT if any ID/SECRET is empty) -----------------
# Placeholders let the app start; replace with real creds for OAuth to work.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:8888/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000
FACEBOOK_APP_ID=replace-me
FACEBOOK_APP_SECRET=replace-me
FACEBOOK_OAUTH_REDIRECT_URL=http://localhost:3000
BACKEND_URL=http://localhost:8888

# --- Postgres: read ONLY by drizzle.config.ts (bun run db:*), never at runtime
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tutor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutor_db  # overrides POSTGRES_*
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
